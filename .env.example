# Copy to .env and adjust. All values are optional for a local demo.

# Admin API bearer token. If empty, a random token is generated and printed at startup.
ADMIN_TOKEN=change-me-to-a-long-random-string

# OpenAI chat model for RAG answers and the admin agent.
# Without a key the app uses deterministic offline answers / an offline tool-calling model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vector store: weaviate (embedded binary or local server) or memory
VECTOR_BACKEND=weaviate
WEAVIATE_MODE=embedded
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# Embeddings: fastembed (local ONNX model, downloaded on first run) or hashing (offline)
EMBEDDINGS_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=3
# RETRIEVAL_MIN_SCORE=0.45

# Runtime data (SQLite, checkpoints, export file, Weaviate data)
# PARKING_DATA_DIR=./var
