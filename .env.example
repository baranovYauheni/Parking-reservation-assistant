# Copy to .env and adjust. All values are optional for a local demo.

# OpenAI chat model for RAG answers.
# Without a key the app uses deterministic offline (extractive) answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vector store: weaviate (embedded binary or local server) or memory
VECTOR_BACKEND=weaviate
WEAVIATE_MODE=embedded
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# Embeddings: fastembed (local ONNX model, downloaded on first run) or hashing (offline)
EMBEDDINGS_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=3
# RETRIEVAL_MIN_SCORE=0.45

# Runtime data (SQLite, Weaviate data)
# PARKING_DATA_DIR=./var
